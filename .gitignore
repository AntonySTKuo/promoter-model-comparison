# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# ─── Editor / tooling ────────────────────────────────────────────────────────
.claude/
.agents/
.codex/
.vscode/
.DS_Store

# ─── Manuscript working files ────────────────────────────────────────────────
# Drafts, figure legends, and reference PDFs live in ../MS4_local-only/, not in
# this repository. The PDF rule is a safety net: third-party papers are
# copyrighted and must never be pushed, even if one is copied in by accident.
*.pdf

# ─── Generated results ───────────────────────────────────────────────────────
# Everything under results/ is reproducible from scripts/ plus tables/. Two
# things are still tracked: the fitted checkpoints, so a reader can redraw the
# figures without refitting, and the rendered PNGs, so the figures can be seen
# without running anything at all.
results/*
!results/models/
!results/figures/

# Vector figures are Illustrator intermediates for compositing the manuscript
# figures, ~33 MB in total, and of no use to a reader.
*.svg
